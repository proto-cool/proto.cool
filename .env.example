# proto.cool — public chrome configuration
#
# These values populate the TUI shell's identity / link clusters and the
# logoblock sigil. The PUBLIC_ prefix matters: it tells SvelteKit / Vite
# the values are safe to surface in client output (they are — this is the
# host operator's public identity, not a secret).
#
# Defaults baked into src/lib/shell/chrome.ts match production. Override
# locally by copying this file to `.env` and editing.

PUBLIC_OWNER_HANDLE=protocol7
PUBLIC_HOST_LABEL=helios
PUBLIC_PDS_HOST=pds.proto.cool

# proto.cool — backend cache + atproto identity
#
# Where the SQLite cache file lives. Defaults to ./data/proto.sqlite.
# PROTO_DB_PATH=./data/proto.sqlite

# The owner DID. The cache and backfill operate over this single repo.
# If unset, backfill resolves it from PUBLIC_OWNER_HANDLE via
# com.atproto.identity.resolveHandle.
# PROTO_OWNER_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
